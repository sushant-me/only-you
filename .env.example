# Meta Model API — fill from the hackathon #resources message / onboarding email.
META_API_BASE=
META_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Multimodal scene reader (falls back to tesseract when unset/unavailable)
MUSE_VISION_MODEL=muse-wonder-1.0
# ONLYYOU_SCENE_READER=tesseract   # force the offline reader
# Optional: open-weights endpoint (Baseten / Modal / Fireworks)
OPEN_WEIGHTS_BASE=
OPEN_WEIGHTS_KEY=
OPEN_WEIGHTS_MODEL=

# Optional: POST security alerts (policy changes, revocations, rejected checkouts) to a SIEM/webhook
# ONLYYOU_WEBHOOK_URL=https://example.internal/hooks/only-you
# ONLYYOU_WEBHOOK_RETRIES=3
# ONLYYOU_WEBHOOK_DELAY=0.25

# Optional: frontier model through the same gate (see docs/frontier.md)
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# or explicit: FRONTIER_API_BASE=http://localhost:11434/v1 FRONTIER_API_KEY=ollama FRONTIER_MODEL=llama3.2
